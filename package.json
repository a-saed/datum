{
  "name": "datum",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "!packages/server-*",
    "demo"
  ],
  "scripts": {
    "build": "npm run build -w datum-sync",
    "test": "npm test --workspaces --if-present",
    "release": "bash scripts/release.sh",
    "release:docker": "bash scripts/release-docker.sh",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
