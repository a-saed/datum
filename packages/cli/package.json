{
  "name": "datum-cli",
  "version": "0.1.0",
  "description": "Zero-install CLI for datum-server: run a local Postgres+PostGIS and datum-server with one command.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/a-saed/datum.git"
  },
  "homepage": "https://a-saed.github.io/datum",
  "bugs": {
    "url": "https://github.com/a-saed/datum/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "datum": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && (chmod +x dist/cli.js 2>/dev/null || true)",
    "test": "vitest run"
  },
  "optionalDependencies": {
    "datum-server-linux-x64": "0.1.0",
    "datum-server-linux-arm64": "0.1.0",
    "datum-server-darwin-x64": "0.1.0",
    "datum-server-darwin-arm64": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
