{
  "name": "datum-sync",
  "version": "0.12.0",
  "description": "Local-first spatial sync for PostGIS. A bounding box is a first-class live sync subscription.",
  "keywords": [
    "postgis",
    "spatial",
    "sync",
    "local-first",
    "pglite",
    "geospatial",
    "maps"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/a-saed/datum.git"
  },
  "homepage": "https://a-saed.github.io/datum",
  "bugs": {
    "url": "https://github.com/a-saed/datum/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "datum-mcp": "./dist/mcp/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react.d.ts"
    },
    "./devtools": {
      "import": "./dist/devtools/index.js",
      "types": "./dist/devtools/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/index.js",
      "types": "./dist/mcp/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/mcp/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@electric-sql/pglite-postgis": "^0.0.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "uuid": "^10.0.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
